# =============================================
# ENVIRONMENT VARIABLES - BUMDes Semplak Barat
# Salin file ini ke .env dan isi nilainya
# =============================================

# === SERVER ===
PORT=3000
NODE_ENV=production

# === DATABASE MySQL ===
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=your-port
DB_NAME=db_bumdes_semplak_barat
DB_USER=your-username
DB_PASSWORD=your-password

# === JWT & SESSION ===
JWT_SECRET=ganti-dengan-random-string-panjang-min-32-karakter
SESSION_SECRET=ganti-dengan-random-string-panjang-min-32-karakter

# === GOOGLE OAUTH ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Ganti dengan URL Railway kamu setelah deploy
GOOGLE_CALLBACK_URL=https://your-app.railway.app/api/auth/google/callback

# === CORS (pisahkan dengan koma, tanpa spasi) ===
# Contoh: https://frontend-kamu.vercel.app,https://app-lain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === KOMERCE SHIPPING API ===
KOMERCE_SHIPPING_COST_API_KEY=your-komerce-api-key
KOMERCE_SHIPPING_DELIVERY_API_KEY=your-komerce-delivery-key

# === WHATSAPP (Opsional - hanya aktifkan jika diperlukan) ===
# WA_ENABLED=false

# === EMAIL (Nodemailer) ===
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# === TWILIO (Opsional) ===
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890
